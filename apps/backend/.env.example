# ─────────────────────────────────────────────────────────────────────────────
# TradePro Backend — Environment Variables
# Copy this file to .env for local development. Never commit .env.
# On Render, set these directly in the "Environment" tab of your service.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# Frontend origin for CORS — set to your Vercel deployment URL in production.
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/stock_dashboard
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/stock_dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stock_dashboard

# ── Redis ─────────────────────────────────────────────────────────────────────
# Option 1 (recommended for Render): Upstash serverless Redis
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# Option 2: Standard ioredis (only used when Upstash vars are NOT set)
# REDIS_URL=redis://127.0.0.1:6379

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ── Zebu Broker — Module 1 ───────────────────────────────────────────────────
ZEBU_USER_ID=your_zebu_user_id
ZEBU_API_KEY=your_zebu_api_key
ZEBU_VENDOR_CODE=your_vendor_code
ZEBU_TOTP_SECRET=your_totp_base32_secret

# NIFTY tokens (stable, rarely change)
ZEBU_NIFTY_FUT_TOKEN=26000
ZEBU_NIFTY_SPOT_TOKEN=26009

# Weekly NIFTY option tokens — UPDATE EVERY THURSDAY after expiry.
# Download: https://go.mynt.in/NFO_symbols.txt
# Grep for NIFTY<DD><MMM><YY>C and NIFTY<DD><MMM><YY>P for the current expiry.
ZEBU_NIFTY_CE_TOKENS=token1,token2,...
ZEBU_NIFTY_PE_TOKENS=token1,token2,...

# ── Aetram Broker — Module 2 ─────────────────────────────────────────────────
AETRAM_API_KEY=your_aetram_api_key
AETRAM_CLIENT_ID=your_aetram_client_id
AETRAM_PASSWORD=your_aetram_password
